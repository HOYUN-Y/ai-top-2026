# Copy to .env; never commit actual secrets.
# OpenRouter API key; choose the model separately.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
KAKAO_BOT_TOKEN=

# Contest action token (aitop100_...). When set, the bot calls the action API from docs/action-api/openapi.json.
AI_TOP_ACTION=

# Kakao REST API key; verify bot API authentication before use.
KAKAO_REST_API=
